# 复制为 deploy/backend/env.sh，并修改 SECRET_KEY、数据库路径和域名
export SECRET_KEY="change-this-to-a-long-random-string"
export DATABASE_PATH="/var/www/canyum-exam/backend/data/test.db"
export CORS_ORIGINS="https://exam.example.com,https://admin.example.com"
